#!/usr/bin/env bash
# FLOW format checker — called by `bin/flow ci` (and `bin/flow ci --format`).
# Returns nonzero if any tracked file is not formatted to Prettier's rules.
#
# Modes:
#   bin/format              — check only (CI gate)
#   bin/format --write      — rewrite all files in place
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--write" ]; then
  exec npx prettier --write .
fi

exec npx prettier --check .
