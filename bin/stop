#!/usr/bin/env bash
# bin/stop — stop this project's dev stack: Vite + nginx.
# Paired with bin/start. Idempotent — safe to run when nothing is running.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOGS="$HOME/code/logs"
NGINX_BIN="$(brew --prefix)/bin/nginx"

say() { echo "$@"; }

kill_pidfile() {
  local pidfile="$1"
  local label="$2"

  if [ ! -f "$pidfile" ]; then
    return 0
  fi

  local pid
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if [ -z "${pid:-}" ]; then
    rm -f "$pidfile"
    return 0
  fi

  if kill -0 "$pid" >/dev/null 2>&1; then
    say "→ stopping $label pid=$pid"
    kill -TERM "$pid" >/dev/null 2>&1 || true
    for _ in $(seq 1 50); do
      if kill -0 "$pid" >/dev/null 2>&1; then
        sleep 0.1
      else
        break
      fi
    done
    if kill -0 "$pid" >/dev/null 2>&1; then
      say "→ forcing $label pid=$pid"
      kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
  fi

  rm -f "$pidfile"
}

say "== stop acme-ai-consulting =="

kill_pidfile "$LOGS/acme_vite.pid" "vite"

if [ -x "$NGINX_BIN" ]; then
  say "→ stopping nginx"
  "$NGINX_BIN" -s stop >/dev/null 2>&1 || true
fi

say "stopped"
