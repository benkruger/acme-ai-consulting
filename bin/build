#!/usr/bin/env bash
# FLOW build — called by `bin/flow ci` (and `bin/flow ci --build`).
# Compiles the production bundle via Vite. Nonzero exit blocks downstream
# CI steps.
#
# Modes:
#   bin/build              — production build (default, CI)
#   bin/build --watch      — watch-mode rebuild for iteration
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--watch" ]; then
  exec npx vite build --watch
fi

exec npx vite build
