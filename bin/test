#!/usr/bin/env bash
# FLOW test runner — called by `bin/flow ci` (and `bin/flow ci --test`).
#
# Modes:
#   bin/test                              — full suite with coverage (CI gate)
#   bin/test --file <path> [extra args]   — single test file, no coverage
#   bin/test --watch [extra args]         — watch mode, no coverage
#   bin/test --ui                         — interactive Vitest UI
#   bin/test --report                     — re-render last coverage HTML
#   bin/test [extra args]                 — full suite; extra args forwarded
#
# Coverage thresholds live in vitest.config.js:
#   lines / statements / functions: 100
#   branches: 80 (Svelte compiles attribute interpolations — e.g.
#     class="foo {bar}" — into defensive nullish branches that are
#     unreachable from userland. See comment in vitest.config.js.)
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--file" ]; then
  shift
  exec npx vitest run "$@"
fi

if [ "${1:-}" = "--watch" ]; then
  shift
  exec npx vitest "$@"
fi

if [ "${1:-}" = "--ui" ]; then
  shift
  exec npx vitest --ui "$@"
fi

if [ "${1:-}" = "--report" ]; then
  html="coverage/index.html"
  if [ ! -f "$html" ]; then
    echo "No coverage report found. Run bin/test first." >&2
    exit 1
  fi
  exec open "$html"
fi

exec npx vitest run --coverage "$@"
