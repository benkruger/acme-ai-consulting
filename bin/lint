#!/usr/bin/env bash
# FLOW linter — called by `bin/flow ci` (and `bin/flow ci --lint`).
# Three gates must all pass:
#   1. Style — ban `svelte-ignore` comments (fix the underlying a11y/compiler
#      issue, don't suppress it). Mirrors hh/web's discipline.
#   2. ESLint — flat config at project root.
#   3. svelte-check — type + template validation, warnings fail the gate.
#
# Modes:
#   bin/lint              — run all three gates (CI)
#   bin/lint --fix        — run ESLint with autofix; style and svelte-check
#                           still execute afterward to surface remaining issues
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--fix" ]; then
  echo "== ESLint --fix =="
  npx eslint . --fix
  echo ""
fi

echo "== Style: svelte-ignore ban =="
if grep -rn "svelte-ignore" src/ 2>/dev/null; then
  echo "FAIL: svelte-ignore comments found. Fix the underlying a11y/compiler issue." >&2
  exit 1
fi
echo "No svelte-ignore comments found."

echo ""
echo "== ESLint =="
npx eslint .

echo ""
echo "== svelte-check =="
exec npx svelte-check --fail-on-warnings
