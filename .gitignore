node_modules/
dist/
coverage/
.DS_Store
*.log
.env
.env.local
.vite/
.claude/
acme-ai-consulting-brief.md

# Local-dev SSL material — regenerate per machine, never commit
env/nginx/ssl/*.key
env/nginx/ssl/*.crt
env/nginx/ssl/*.csr
env/nginx/ssl/*.pass.key

# Playwright MCP artifacts — page dumps + screenshots are session-local
.playwright-mcp/
/*.png
/*.jpeg
/*.jpg

# Ephemeral FLOW staging files — written by commit / issue skills and
# deleted by their respective Rust commands after use. When a command
# fails before cleanup (e.g. CI fails inside finalize-commit), the
# file is left behind and git add -A will stage it on retry.
.flow-commit-msg
.flow-issue-body
.flow-issue-body-*
.flow-states/
